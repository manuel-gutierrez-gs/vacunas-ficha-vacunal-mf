{
  "compilerOptions": {
    "target": "es2018",
    "module": "esnext",
    "moduleResolution": "node",
    "noEmitOnError": true,
    "lib": ["es2017", "dom"],
    "strict": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "sourceMap": true,
    "inlineSources": true,
    "rootDir": "./",
    "preserveSymlinks": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@module/*": ["src/module/*"],
      "@routing/*": ["src/routing/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": ["./src/**/*.ts", "./test/**/*.ts"]
}
